<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group5.shuttle.controller.AiChatController"
      spacing="0" style="-fx-background-color: #0D1117;">

    <HBox alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-border-color: #30363d; -fx-border-width: 0 0 1 0;">
        <Label text="AI ADVISOR" style="-fx-text-fill: #8957e5; -fx-font-weight: bold;" />
    </HBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="chatHistory" spacing="10" style="-fx-padding: 15;" />
    </ScrollPane>

    <HBox spacing="10" style="-fx-padding: 15; -fx-background-color: #161B22;">
        <TextField fx:id="inputField" promptText="Ask AI..." HBox.hgrow="ALWAYS" onAction="#handleInput"
                   style="-fx-background-color: #0D1117; -fx-text-fill: white; -fx-border-color: #30363d;" />
    </HBox>
</VBox>