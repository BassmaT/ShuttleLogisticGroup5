<?xml version="1.0" encoding="UTF-8"?>

<!-- Importiert die JavaFX-Klassen, die in dieser Datei verwendet werden. -->
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>

<!--
    Haupt-Dashboard der App.
    BorderPane teilt das Fenster in Bereiche auf: oben (top), links (left), Mitte (center).
    fx:controller verknüpft diese FXML-Datei mit der MainController-Klasse.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.MainController"
            style="-fx-background-color: #1e1e1e; -fx-padding: 20;">

    <!-- Kopfzeile oben mit dem App-Titel -->
    <top>
        <Label text="Shuttle Dashboard"
               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Linke Seitenleiste mit den Navigations-Buttons -->
    <left>
        <VBox spacing="15" style="-fx-padding: 20;">
            <!-- Jeder Button öffnet einen anderen Bereich der App -->
            <Button text="Mission Control" fx:id="btnMission"
                    style="-fx-font-size: 13px; -fx-min-width: 140;" />
            <Button text="Technician" fx:id="btnTechnician"
                    style="-fx-font-size: 13px; -fx-min-width: 140;" />
            <Button text="Inventory" fx:id="btnInventory"
                    style="-fx-font-size: 13px; -fx-min-width: 140;" />
            <Button text="History" fx:id="btnHistory"
                    style="-fx-font-size: 13px; -fx-min-width: 140;" />
            <Button text="Staff" fx:id="btnStaff"
                    style="-fx-font-size: 13px; -fx-min-width: 140;" />
            <Button text="Logistics" fx:id="btnLogistics"
                    style="-fx-font-size: 13px; -fx-min-width: 140;" />
            <Button text="Schedule" fx:id="btnSchedule"
                    style="-fx-font-size: 13px; -fx-min-width: 140;" />
        </VBox>
    </left>

    <!-- Hauptbereich in der Mitte mit scrollbarem Inhalt -->
    <center>
        <!-- ScrollPane ermöglicht Scrollen, wenn der Inhalt zu groß für das Fenster ist -->
        <ScrollPane fitToWidth="true" style="-fx-background: #1e1e1e; -fx-background-color: #1e1e1e; -fx-border-color: transparent;">
        <VBox spacing="16" style="-fx-padding: 20; -fx-background-color: #1e1e1e;">

            <!-- Landing-Banner: nur während der Landephase und Sensordaten-Ladephase sichtbar.
                 Wird vom Controller ein-/ausgeblendet je nach AppPhase. -->
            <VBox fx:id="landingBanner" spacing="10"
                  style="-fx-background-color: #0a0a2a; -fx-padding: 16; -fx-background-radius: 8;">
                <Label text="SHUTTLE APPROACH"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label fx:id="lblLandingCountdown"
                       text="Shuttle approaching..."
                       style="-fx-text-fill: #66aaff; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <ProgressBar fx:id="progressLanding" prefWidth="500" progress="0.0"
                             style="-fx-accent: #66aaff;"/>
                <Label fx:id="lblLandingStatus"
                       text="Awaiting landing clearance..."
                       style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Überschrift für den Fortschrittsbereich -->
            <Label text="Takeover Progress"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />

            <!-- Fortschrittsbalken: 0.0 = 0%, 1.0 = 100%. Farbe ist grün. -->
            <ProgressBar fx:id="progressTakeover" prefWidth="400" progress="0.0"
                         style="-fx-accent: #66ff66;"/>

            <!-- Zeigt an, welche Teile bereits freigegeben sind (✓ = ja, ✗ = nein) -->
            <Label fx:id="lblApprovalStatus"
                   text="Orbiter ✗   SRB ✗   External Tank ✗"
                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;" />

            <!-- Zeigt die schlimmste aktuell aktive Warnung an -->
            <Label fx:id="lblWarning"
                   text="Loading..."
                   style="-fx-text-fill: #ffcc00; -fx-font-size: 15px;" />

            <!-- Allgemeiner Systemstatus, z. B. "Systems nominal" -->
            <Label fx:id="lblStatus"
                   text="Loading..."
                   style="-fx-text-fill: #66ff66; -fx-font-size: 15px;" />

            <!-- Erscheint nur, wenn alle drei Teile freigegeben wurden (100%) -->
            <Button fx:id="btnFinish"
                    text="Takeover Complete"
                    visible="false"
                    style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-background-color: #66ff66; -fx-text-fill: #1e1e1e; -fx-padding: 10 20;" />

            <!-- Überschrift für den Abschnitt "Aktive Arbeit" -->
            <Label text="Active Work"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" />

            <!-- Wird im Controller dynamisch befüllt: wer arbeitet gerade wo -->
            <VBox fx:id="activeWorkContainer" spacing="4" />

            <!-- Überschrift für die letzte Aktivität -->
            <Label text="Last Activity"
                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 6 0 0 0;" />

            <!-- Zeigt die zuletzt abgeschlossene Aktion an -->
            <Label fx:id="lblLastActivity" text="–"
                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;" />

            <!-- Überschrift für die Sensor-Detailansicht -->
            <Label text="Sensor Details"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" />

            <!-- Wird im Controller dynamisch befüllt: alle Sensoren mit Messwerten und Status -->
            <VBox fx:id="sensorContainer" spacing="5" />

            <!-- Überschrift für den 3-Tage-Zeitplan -->
            <Label text="3-Day Schedule"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" />

            <!-- Wird im Controller dynamisch befüllt: alle Tage und Einträge aus schedule.json -->
            <VBox fx:id="scheduleContainer" spacing="3" />

            <!-- Überschrift für Predictive Maintenance -->
            <Label text="Predictive Maintenance"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" />

            <!-- Wird im Controller dynamisch befüllt: Trendwarnungen aus den letzten 5 Flügen -->
            <VBox fx:id="predictiveContainer" spacing="3" />

        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
