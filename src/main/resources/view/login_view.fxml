<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group5.shuttle.controller.LoginController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #0d1117; -fx-padding: 60 80;"
      prefWidth="800" prefHeight="600">

    <!-- Logo / Titel -->
    <Label text="SHUTTLE DASHBOARD"
           style="-fx-text-fill: #66aaff; -fx-font-size: 28px; -fx-font-weight: bold; -fx-letter-spacing: 3;"/>

    <Label text="Mission Control System"
           style="-fx-text-fill: #8b949e; -fx-font-size: 14px;"/>

    <!-- Trennlinie -->
    <HBox prefHeight="1" prefWidth="300" style="-fx-background-color: #21262d;"/>

    <!-- Login-Box -->
    <VBox alignment="CENTER" spacing="14"
          style="-fx-background-color: #161b22; -fx-border-color: #21262d; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 40 60;">

        <Label text="Log in"
               style="-fx-text-fill: #e6edf3; -fx-font-size: 16px; -fx-font-weight: bold;"/>

        <Label text="Choose your name."
               style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>

        <ComboBox fx:id="cmbEmployee"
                  promptText="Name loading..."
                  prefWidth="320"
                  style="-fx-background-color: #21262d; -fx-text-fill: #e6edf3; -fx-border-color: #30363d; -fx-font-size: 13px;"/>

        <Label fx:id="lblRole"
               text=""
               style="-fx-text-fill: #66aaff; -fx-font-size: 13px;"/>

        <Label fx:id="lblError"
               text=""
               style="-fx-text-fill: #ff4444; -fx-font-size: 12px;"/>

        <Button fx:id="btnLogin"
                text="Anmelden"
                onAction="#handleLogin"
                prefWidth="200"
                style="-fx-background-color: #1f6feb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 20;"/>

    </VBox>

    <!-- Hinweis -->
    <Label text="Demo-System · No real authentification yet."
           style="-fx-text-fill: #484f58; -fx-font-size: 11px;"/>

</VBox>
