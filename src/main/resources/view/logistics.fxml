<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>

<!--
    Logistics and order management.
    Top: form for submitting a new order request.
    Middle: table of all orders awaiting approval (with Approve/Reject buttons).
    Bottom: full overview of all orders with status.
    fx:controller links this file to LogisticsController.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.LogisticsController"
            style="-fx-background-color: #0D1117; -fx-padding: 20;">

    <!-- Page heading -->
    <top>
        <Label text="Logistics &amp; Orders"
               style="-fx-font-size: 28px; -fx-text-fill: #4B9CFF; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Main area with order form and tables -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #0D1117; -fx-background-color: #0D1117; -fx-border-color: transparent;">
            <VBox spacing="16" style="-fx-padding: 10; -fx-background-color: #0D1117;">

                <!-- ── Order form ──────────────────────────────────── -->
                <Label text="New Order Request"
                       style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px; -fx-font-weight: bold;"/>

                <!-- Form row 1: part name + quantity + ordered by -->
                <HBox spacing="12" style="-fx-alignment: CENTER_LEFT;">
                    <!-- ComboBox: shows all inventory items -->
                    <ComboBox fx:id="cmbPartName"
                              promptText="Select part"
                              prefWidth="260"
                              style="-fx-font-size: 13px;"/>
                    <TextField fx:id="txtQuantity"
                               promptText="Qty"
                               prefWidth="60"
                               style="-fx-font-size: 13px;"/>
                    <!-- ComboBox: shows all employees -->
                    <ComboBox fx:id="cmbOrderedBy"
                              promptText="Ordered by"
                              prefWidth="190"
                              style="-fx-font-size: 13px;"/>
                </HBox>

                <!-- Form row 2: reason + place order button -->
                <HBox spacing="12" style="-fx-alignment: CENTER_LEFT;">
                    <TextField fx:id="txtReason"
                               promptText="Reason for order"
                               prefWidth="464"
                               style="-fx-font-size: 13px;"/>
                    <Button fx:id="btnPlaceOrder"
                            text="Place Order"
                            style="-fx-font-size: 13px; -fx-background-color: #4B9CFF; -fx-text-fill: #0D1117; -fx-font-weight: bold; -fx-padding: 7 16;"/>
                </HBox>

                <Separator style="-fx-background-color: #30363d;"/>

                <!-- ── Current stock ──────────────────────────────────── -->
                <Label text="Current Stock"
                       style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <!-- Populated dynamically in the controller with colour-coded labels -->
                <VBox fx:id="stockContainer" spacing="3"/>

                <Separator style="-fx-background-color: #30363d;"/>

                <!-- ── Pending approvals ────────────────────────── -->
                <Label text="Pending Approval"
                       style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <!-- Table of orders with status PENDING_APPROVAL -->
                <!-- Last column contains Approve/Reject buttons (set via CellFactory in the controller) -->
                <TableView fx:id="pendingTable"
                           style="-fx-background: #161B22; -fx-background-color: #161B22;"
                           prefHeight="160">
                    <columns>
                        <TableColumn fx:id="colPendingNr"        text="Order #"    prefWidth="85"/>
                        <TableColumn fx:id="colPendingPart"      text="Part"       prefWidth="160"/>
                        <TableColumn fx:id="colPendingQty"       text="Qty"        prefWidth="45"/>
                        <TableColumn fx:id="colPendingBy"        text="Ordered By" prefWidth="130"/>
                        <TableColumn fx:id="colPendingReason"    text="Reason"     prefWidth="200"/>
                        <!-- Approve/Reject buttons are set in the controller via CellFactory -->
                        <TableColumn fx:id="colPendingAction"    text="Action"     prefWidth="175"/>
                    </columns>
                    <placeholder>
                        <Label text="No pending orders" style="-fx-text-fill: #66ff66;"/>
                    </placeholder>
                </TableView>

                <Separator style="-fx-background-color: #30363d;"/>

                <!-- ── All orders ─────────────────────────────────── -->
                <Label text="All Orders"
                       style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <!-- Full overview of all orders with status (colour-coded) -->
                <TableView fx:id="allOrdersTable"
                           style="-fx-background: #161B22; -fx-background-color: #161B22;"
                           prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colAllNr"          text="Order #"     prefWidth="85"/>
                        <TableColumn fx:id="colAllPart"        text="Part"        prefWidth="150"/>
                        <TableColumn fx:id="colAllQty"         text="Qty"         prefWidth="45"/>
                        <TableColumn fx:id="colAllBy"          text="Ordered By"  prefWidth="120"/>
                        <TableColumn fx:id="colAllStatus"      text="Status"      prefWidth="140"/>
                        <TableColumn fx:id="colAllApprovedBy"  text="Approved By" prefWidth="120"/>
                        <TableColumn fx:id="colAllDate"        text="Order Date"  prefWidth="130"/>
                    </columns>
                    <placeholder>
                        <Label text="No orders yet" style="-fx-text-fill: #aaaaaa;"/>
                    </placeholder>
                </TableView>

            </VBox>
        </ScrollPane>
    </center>

    <!-- Back button at the bottom -->
    <bottom>
        <Button text="← Back to Dashboard"
                fx:id="btnBack"
                style="-fx-font-size: 14px; -fx-padding: 8; -fx-background-color: #21262d; -fx-text-fill: #8b949e;"/>
    </bottom>

</BorderPane>
