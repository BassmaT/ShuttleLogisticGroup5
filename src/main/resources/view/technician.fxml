<?xml version="1.0" encoding="UTF-8"?>

<!-- Imports the required JavaFX classes -->
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<!--
    Technician panel.
    Shows all sensors of all shuttle parts with readings and status.
    fx:controller links this file to TechnicianController.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.TechnicianController"
            style="-fx-background-color: #0D1117; -fx-padding: 20;">

    <!-- Page heading -->
    <top>
        <Label text="Technician Panel"
               style="-fx-font-size: 28px; -fx-text-fill: #4B9CFF; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Main area with the sensor table -->
    <center>
        <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
            <!-- sensorTable is populated with sensor data in the controller -->
            <TableView fx:id="sensorTable"
                       style="-fx-background: #0D1117; -fx-background-color: #161B22;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <!-- Column: shuttle part (Orbiter, SRB, External Tank) -->
                    <TableColumn fx:id="colPart"   text="Part"   prefWidth="130"/>
                    <!-- Column: sensor name, e.g. "hullTemperature" -->
                    <TableColumn fx:id="colSensor" text="Sensor" prefWidth="180"/>
                    <!-- Column: current reading, e.g. "520.00" -->
                    <TableColumn fx:id="colValue"  text="Value"  prefWidth="100"/>
                    <!-- Column: rating (OK / WARNING / REPLACE), colour-coded -->
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Back button at the bottom -->
    <bottom>
        <Button text="← Back to Dashboard"
                fx:id="btnBack"
                style="-fx-font-size: 14px; -fx-padding: 8 16; -fx-background-color: #161B22; -fx-text-fill: #4B9CFF; -fx-border-color: #21262d; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
    </bottom>

</BorderPane>
