<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>

<!--
    Landing-Screen: wird beim Start der App angezeigt.
    Simuliert den Shuttle-Landeanflug mit einem 15-Sekunden-Timer (= 15 Minuten real).
    Nach der Landung erscheint eine Erfolgsmeldung; danach wechselt die App automatisch
    zum Haupt-Dashboard.
    fx:controller verknüpft diese Datei mit LandingController.
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.group5.shuttle.controller.LandingController"
           style="-fx-background-color: #0D1117;">

    <VBox alignment="CENTER" spacing="30"
          style="-fx-padding: 60;">

        <!-- Shuttle-Symbol / Titel -->
        <Label text="🚀  SHUTTLE DASHBOARD"
               style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>

        <!-- Countdown-Anzeige, z. B. "Approaching in 15:00 min..." -->
        <Label fx:id="lblCountdown"
               text="Shuttle approaching..."
               style="-fx-text-fill: #4B9CFF; -fx-font-size: 20px; -fx-font-weight: bold;"/>

        <!-- Simulierter Fortschrittsbalken für den Landeanflug -->
        <ProgressBar fx:id="progressLanding"
                     prefWidth="400" progress="0.0"
                     style="-fx-accent: #58a6ff;"/>

        <!-- Status-Text unter dem Balken -->
        <Label fx:id="lblStatus"
               text="Awaiting landing clearance..."
               style="-fx-text-fill: #8b949e; -fx-font-size: 14px;"/>

    </VBox>

</StackPane>
