<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>

<!--
    Staff overview.
    Left: list of all employees
    Right: clicking an employee shows their repair and routine tasks.
    fx:controller links this file to StaffController.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.StaffController"
            style="-fx-background-color: #0D1117; -fx-padding: 20;">

    <!-- Page heading -->
    <top>
        <Label text="Staff Overview"
               style="-fx-font-size: 28px; -fx-text-fill: #4B9CFF; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Left sidebar: list of all employees -->
    <left>
        <VBox spacing="8" style="-fx-padding: 10 16 10 0; -fx-min-width: 200; -fx-background-color: #0D1117; -fx-border-color: #21262d; -fx-border-width: 0 1 0 0;">
            <!-- Section heading -->
            <Label text="Employees"
                   style="-fx-text-fill: #8b949e; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Separator style="-fx-background-color: #21262d;"/>
            <!-- ListView shows all employees – clicking one displays their tasks on the right -->
            <ListView fx:id="employeeList"
                      style="-fx-background: #0D1117; -fx-background-color: #161B22; -fx-border-color: #21262d;"
                      VBox.vgrow="ALWAYS"
                      prefHeight="500"/>
        </VBox>
    </left>

    <!-- Main area on the right: details of the selected employee -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="14" style="-fx-padding: 0 0 10 16; -fx-background-color: transparent;">

                <!-- Name of the selected employee (large, white) -->
                <Label fx:id="lblEmployeeName"
                       text="← Select an employee"
                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>

                <!-- Role and team of the employee -->
                <HBox spacing="20">
                    <Label fx:id="lblEmployeeRole" text=""
                           style="-fx-text-fill: #4B9CFF; -fx-font-size: 14px;"/>
                    <Label fx:id="lblEmployeeTeam" text=""
                           style="-fx-text-fill: #8b949e; -fx-font-size: 14px;"/>
                </HBox>

                <Separator style="-fx-background-color: #21262d;"/>

                <!-- Section: repair tasks -->
                <Label text="Repair Tasks"
                       style="-fx-text-fill: #8b949e; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <!-- Table of repair tasks for this employee -->
                <TableView fx:id="repairTaskTable"
                           style="-fx-background: #0D1117; -fx-background-color: #161B22;"
                           prefHeight="160">
                    <columns>
                        <!-- Shuttle part to which the repair relates -->
                        <TableColumn fx:id="colRepairPart"   text="Part"    prefWidth="130"/>
                        <!-- Affected sensor, e.g. "coolantPressure" -->
                        <TableColumn fx:id="colRepairSensor" text="Sensor"  prefWidth="150"/>
                        <!-- Action to be taken, e.g. "Replace component" -->
                        <TableColumn fx:id="colRepairAction" text="Action"  prefWidth="190"/>
                        <!-- Status: "WARNING", "REPLACE" or done -->
                        <TableColumn fx:id="colRepairStatus" text="Status"  prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No repair tasks assigned"
                               style="-fx-text-fill: #8b949e;"/>
                    </placeholder>
                </TableView>

                <Separator style="-fx-background-color: #21262d;"/>

                <!-- Section: routine tasks -->
                <Label text="Routine Tasks"
                       style="-fx-text-fill: #8b949e; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <!-- Table of routine tasks for this employee -->
                <!-- The done column contains a checkbox – ticking it sets completedAt -->
                <TableView fx:id="routineTaskTable"
                           style="-fx-background: #0D1117; -fx-background-color: #161B22;"
                           prefHeight="200">
                    <columns>
                        <!-- Task name, e.g. "Clean Cabin" -->
                        <TableColumn fx:id="colRoutineName" text="Task"        prefWidth="200"/>
                        <!-- Associated shuttle part -->
                        <TableColumn fx:id="colRoutinePart" text="Part"        prefWidth="130"/>
                        <!-- Estimated duration in minutes -->
                        <TableColumn fx:id="colRoutineEst"  text="Est. (min)"  prefWidth="90"/>
                        <!-- Checkbox: done yes/no -->
                        <TableColumn fx:id="colRoutineDone" text="Done"        prefWidth="60"/>
                        <!-- Completion timestamp (empty if not yet done) -->
                        <TableColumn fx:id="colRoutineTime" text="Completed At" prefWidth="140"/>
                    </columns>
                    <placeholder>
                        <Label text="No routine tasks assigned"
                               style="-fx-text-fill: #8b949e;"/>
                    </placeholder>
                </TableView>

            </VBox>
        </ScrollPane>
    </center>

    <!-- Back button at the bottom left -->
    <bottom>
        <Button text="← Back to Dashboard"
                fx:id="btnBack"
                style="-fx-font-size: 14px; -fx-padding: 8 16; -fx-background-color: #161B22; -fx-text-fill: #4B9CFF; -fx-border-color: #21262d; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </bottom>

</BorderPane>
