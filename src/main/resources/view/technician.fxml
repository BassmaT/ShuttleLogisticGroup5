<?xml version="1.0" encoding="UTF-8"?>

<!-- Importiert die benötigten JavaFX-Klassen -->
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<!--
    Techniker-Panel.
    Zeigt alle Sensoren aller Shuttle-Teile mit Messwerten und Status.
    fx:controller verknüpft die Datei mit TechnicianController.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.TechnicianController"
            style="-fx-background-color: #0D1117; -fx-padding: 20;">

    <!-- Seitenüberschrift -->
    <top>
        <Label text="Technician Panel"
               style="-fx-font-size: 28px; -fx-text-fill: #4B9CFF; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Hauptbereich mit der Sensor-Tabelle -->
    <center>
        <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
            <!-- sensorTable wird im Controller mit Sensordaten befüllt -->
            <TableView fx:id="sensorTable"
                       style="-fx-background: #0D1117; -fx-background-color: #161B22;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <!-- Spalte: Shuttle-Teil (Orbiter, SRB, External Tank) -->
                    <TableColumn fx:id="colPart"   text="Part"   prefWidth="130"/>
                    <!-- Spalte: Sensorname, z. B. "hullTemperature" -->
                    <TableColumn fx:id="colSensor" text="Sensor" prefWidth="180"/>
                    <!-- Spalte: Aktueller Messwert, z. B. "520.00" -->
                    <TableColumn fx:id="colValue"  text="Value"  prefWidth="100"/>
                    <!-- Spalte: Bewertung (OK / WARNING / REPLACE), farbig -->
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Zurück-Button unten -->
    <bottom>
        <Button text="← Back to Dashboard"
                fx:id="btnBack"
                style="-fx-font-size: 14px; -fx-padding: 8 16; -fx-background-color: #161B22; -fx-text-fill: #4B9CFF; -fx-border-color: #21262d; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
    </bottom>

</BorderPane>
