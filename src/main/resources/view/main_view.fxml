<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.MainController"
            style="-fx-background-color: #0D1117;">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT"
              style="-fx-padding: 20; -fx-background-color: #12161D; -fx-border-color: #30363d; -fx-border-width: 0 0 1 0;">

            <Label text="MISSION CONTROL" style="-fx-text-fill: #4B9CFF; -fx-font-weight: bold; -fx-font-size: 20px; -fx-letter-spacing: 2px;"/>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="lblCurrentUser" text=""
                   style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"/>

            <Button text="⇄" onAction="#switchUser"
                    style="-fx-background-color: #21262d; -fx-text-fill: #8b949e; -fx-cursor: hand;
                       -fx-padding: 4 8; -fx-border-color: #30363d; -fx-border-radius: 4;"/>

            <Button onAction="#toggleAiChat" text="🤖 AI Chat"
                    style="-fx-background-color: #21262d; -fx-text-fill: #8957e5; -fx-border-color: #8957e5; -fx-border-radius: 5; -fx-cursor: hand;"/>

            <HBox spacing="10" alignment="CENTER" style="-fx-background-color: rgba(75, 156, 255, 0.1); -fx-padding: 8 15; -fx-background-radius: 20;">
                <Circle radius="4" fill="#2EA043" />
                <Label fx:id="lblStatus" text="SYSTEMS NOMINAL" style="-fx-text-fill: #2EA043; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox spacing="10"
              style="-fx-padding: 20; -fx-background-color: #0D1117; -fx-border-color: #30363d; -fx-border-width: 0 1 0 0;">
            <Button text="Dashboard"
                    style="-fx-background-color: #21262d; -fx-text-fill: white; -fx-min-width: 160; -fx-alignment: BASELINE_LEFT;"/>
            <Button fx:id="btnMission"    text="Mission Control" style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-min-width: 160; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="btnTechnician" text="Sensor Data"     style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-min-width: 160; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="btnInventory"  text="Inventory"       style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-min-width: 160; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="btnHistory"    text="History"         style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-min-width: 160; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="btnStaff"      text="Staff"           style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-min-width: 160; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="btnLogistics"  text="Logistics"       style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-min-width: 160; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>
            <Button fx:id="btnSchedule"   text="Schedule"        style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-min-width: 160; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 25;">

                <VBox fx:id="landingBanner" spacing="15"
                      style="-fx-background-color: #161B22; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #30363d; -fx-border-radius: 12;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="SHUTTLE APPROACH" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblLandingCountdown" text="T-Minus: --:--" style="-fx-text-fill: #58a6ff; -fx-font-family: 'Monospaced'; -fx-font-size: 16px;"/>
                    </HBox>
                    <ProgressBar fx:id="progressLanding" prefWidth="Infinity" progress="0.0" style="-fx-accent: #58a6ff;"/>
                    <Label fx:id="lblLandingStatus" text="Awaiting data..." style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="10"
                      style="-fx-background-color: #161B22; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #30363d; -fx-border-radius: 12;">
                    <Label text="TAKEOVER PROGRESS" style="-fx-text-fill: #8b949e; -fx-font-weight: bold;"/>
                    <ProgressBar fx:id="progressTakeover" prefWidth="Infinity" progress="0.0" style="-fx-accent: #66ff66;"/>
                    <Label fx:id="lblScheduleStatus" text="Schedule: –" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
                    <Label fx:id="lblApprovalStatus" text="Checking components..." style="-fx-text-fill: white;"/>
                    <Label fx:id="lblWarning" text="Scanning for anomalies..." style="-fx-text-fill: #ffcc00;"/>
                    <Button fx:id="btnFinish" text="Complete Takeover" visible="false" style="-fx-background-color: #66ff66; -fx-text-fill: #0D1117; -fx-font-weight: bold;"/>
                </VBox>

                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" spacing="10"
                          style="-fx-background-color: #161B22; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="SENSOR MATRIX" style="-fx-text-fill: #8b949e; -fx-font-weight: bold;"/>
                        <VBox fx:id="sensorContainer" spacing="8" />
                    </VBox>

                    <VBox GridPane.columnIndex="1" spacing="10"
                          style="-fx-background-color: #161B22; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="ACTIVE TASKS" style="-fx-text-fill: #8b949e; -fx-font-weight: bold;"/>
                        <VBox fx:id="activeWorkContainer" spacing="8" />
                        <Label text="Last Activity:" style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-padding: 10 0 0 0;"/>
                        <Label fx:id="lblLastActivity" text="None" style="-fx-text-fill: #58a6ff; -fx-font-size: 11px;"/>
                    </VBox>
                </GridPane>

                <HBox spacing="20">
                    <VBox HBox.hgrow="ALWAYS" spacing="10"
                          style="-fx-background-color: #161B22; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="3-DAY SCHEDULE" style="-fx-text-fill: #8b949e; -fx-font-weight: bold;"/>
                        <VBox fx:id="scheduleContainer" spacing="5" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10"
                          style="-fx-background-color: #161B22; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #8957e5; -fx-border-width: 0.5;">
                        <Label text="PREDICTIVE AI TRENDS" style="-fx-text-fill: #8957e5; -fx-font-weight: bold;"/>
                        <VBox fx:id="predictiveContainer" spacing="5" />
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <right>
        <StackPane fx:id="aiDrawer" />
    </right>

</BorderPane>
