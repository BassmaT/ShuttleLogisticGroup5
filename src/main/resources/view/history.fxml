<?xml version="1.0" encoding="UTF-8"?>

<!-- Imports the required JavaFX classes -->
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<!--
    Maintenance history.
    Shows all repairs performed during this session.
    Data is cleared when the app is closed (in-memory only).
    fx:controller links this file to HistoryController.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.HistoryController"
            style="-fx-background-color: #0D1117; -fx-padding: 20;">

    <!-- Page heading -->
    <top>
        <Label text="Mission History"
               style="-fx-font-size: 28px; -fx-text-fill: #4B9CFF; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Main area with the history table -->
    <center>
        <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
            <!-- historyTable is populated with repair tickets in the controller -->
            <TableView fx:id="historyTable"
                       style="-fx-background: #0D1117; -fx-background-color: #161B22;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <!-- Date and time of the repair -->
                    <TableColumn fx:id="colDate"       text="Date"       prefWidth="100"/>
                    <!-- Affected shuttle part -->
                    <TableColumn fx:id="colPart"       text="Part"       prefWidth="120"/>
                    <!-- Sensor that triggered the repair -->
                    <TableColumn fx:id="colSensor"     text="Sensor"     prefWidth="150"/>
                    <!-- Fault status before the repair (colour-coded) -->
                    <TableColumn fx:id="colOldStatus"  text="Status"     prefWidth="90"/>
                    <!-- Action performed including the part used -->
                    <TableColumn fx:id="colAction"     text="Action"     prefWidth="200"/>
                    <!-- Name of the technician -->
                    <TableColumn fx:id="colTechnician" text="Technician" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Back button at the bottom -->
    <bottom>
        <Button text="← Back to Dashboard"
                fx:id="btnBack"
                style="-fx-font-size: 14px; -fx-padding: 8 16; -fx-background-color: #161B22; -fx-text-fill: #4B9CFF; -fx-border-color: #21262d; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
    </bottom>

</BorderPane>
