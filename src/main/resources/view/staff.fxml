<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>

<!--
    Staff-Übersicht.
    Links: Liste aller Mitarbeiter (aus employees.json).
    Rechts: Beim Klick auf einen Mitarbeiter werden seine Reparatur- und Routineaufgaben angezeigt.
    fx:controller verknüpft diese Datei mit StaffController.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.StaffController"
            style="-fx-background-color: #1e1e1e; -fx-padding: 20;">

    <!-- Seitenüberschrift -->
    <top>
        <Label text="Staff Overview"
               style="-fx-font-size: 28px; -fx-text-fill: white; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Linke Seitenleiste: Liste aller Mitarbeiter -->
    <left>
        <VBox spacing="8" style="-fx-padding: 10 16 10 0; -fx-min-width: 200;">
            <!-- Abschnittsüberschrift -->
            <Label text="Employees"
                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Separator style="-fx-background-color: #444;"/>
            <!-- ListView zeigt alle Mitarbeiter – beim Klick werden rechts die Tasks angezeigt -->
            <ListView fx:id="employeeList"
                      style="-fx-background: #2a2a2a; -fx-background-color: #2a2a2a; -fx-border-color: #444;"
                      VBox.vgrow="ALWAYS"
                      prefHeight="500"/>
        </VBox>
    </left>

    <!-- Hauptbereich rechts: Details des ausgewählten Mitarbeiters -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #1e1e1e; -fx-background-color: #1e1e1e; -fx-border-color: transparent;">
            <VBox spacing="14" style="-fx-padding: 0 0 10 16; -fx-background-color: #1e1e1e;">

                <!-- Name des ausgewählten Mitarbeiters (groß, weiß) -->
                <Label fx:id="lblEmployeeName"
                       text="← Select an employee"
                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>

                <!-- Rolle und Team des Mitarbeiters -->
                <HBox spacing="20">
                    <Label fx:id="lblEmployeeRole" text=""
                           style="-fx-text-fill: #66aaff; -fx-font-size: 14px;"/>
                    <Label fx:id="lblEmployeeTeam" text=""
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;"/>
                </HBox>

                <Separator style="-fx-background-color: #444;"/>

                <!-- Abschnitt: Reparaturaufgaben -->
                <Label text="Repair Tasks"
                       style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <!-- Tabelle der Reparaturaufgaben dieses Mitarbeiters -->
                <TableView fx:id="repairTaskTable"
                           style="-fx-background: #2a2a2a; -fx-background-color: #2a2a2a;"
                           prefHeight="160">
                    <columns>
                        <!-- Shuttle-Teil, auf das sich die Reparatur bezieht -->
                        <TableColumn fx:id="colRepairPart"   text="Part"    prefWidth="130"/>
                        <!-- Betroffener Sensor, z. B. "coolantPressure" -->
                        <TableColumn fx:id="colRepairSensor" text="Sensor"  prefWidth="150"/>
                        <!-- Durchzuführende Maßnahme, z. B. "Replace component" -->
                        <TableColumn fx:id="colRepairAction" text="Action"  prefWidth="190"/>
                        <!-- Status: "WARNING", "REPLACE" oder erledigt -->
                        <TableColumn fx:id="colRepairStatus" text="Status"  prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No repair tasks assigned"
                               style="-fx-text-fill: #aaaaaa;"/>
                    </placeholder>
                </TableView>

                <Separator style="-fx-background-color: #444;"/>

                <!-- Abschnitt: Routineaufgaben -->
                <Label text="Routine Tasks"
                       style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <!-- Tabelle der Routineaufgaben dieses Mitarbeiters -->
                <!-- Die Done-Spalte enthält eine Checkbox – beim Abhaken wird completedAt gesetzt -->
                <TableView fx:id="routineTaskTable"
                           style="-fx-background: #2a2a2a; -fx-background-color: #2a2a2a;"
                           prefHeight="200">
                    <columns>
                        <!-- Aufgabenbezeichnung, z. B. "Clean Cabin" -->
                        <TableColumn fx:id="colRoutineName" text="Task"        prefWidth="200"/>
                        <!-- Zugehöriges Shuttle-Teil -->
                        <TableColumn fx:id="colRoutinePart" text="Part"        prefWidth="130"/>
                        <!-- Geschätzte Dauer in Minuten -->
                        <TableColumn fx:id="colRoutineEst"  text="Est. (min)"  prefWidth="90"/>
                        <!-- Checkbox: erledigt ja/nein -->
                        <TableColumn fx:id="colRoutineDone" text="Done"        prefWidth="60"/>
                        <!-- Zeitstempel der Erledigung (leer wenn noch nicht erledigt) -->
                        <TableColumn fx:id="colRoutineTime" text="Completed At" prefWidth="140"/>
                    </columns>
                    <placeholder>
                        <Label text="No routine tasks assigned"
                               style="-fx-text-fill: #aaaaaa;"/>
                    </placeholder>
                </TableView>

            </VBox>
        </ScrollPane>
    </center>

    <!-- Zurück-Button unten links -->
    <bottom>
        <Button text="← Back to Dashboard"
                fx:id="btnBack"
                style="-fx-font-size: 14px; -fx-padding: 8; -fx-background-color: #3a3a3a; -fx-text-fill: white;"/>
    </bottom>

</BorderPane>
