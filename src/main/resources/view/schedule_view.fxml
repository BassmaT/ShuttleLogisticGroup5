<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>

<!--
    Interactive 3-day schedule.
    Displays all days and entries as tables.
    Assigned employees can be changed via ComboBox
    (e.g. in case of illness or leave).
    fx:controller links this file to ScheduleController.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.ScheduleController"
            style="-fx-background-color: #0D1117; -fx-padding: 20;">

    <!-- Page heading -->
    <top>
        <Label text="3-Day Schedule"
               style="-fx-font-size: 28px; -fx-text-fill: #4B9CFF; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Main area: tables per day, scrollable -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #0D1117; -fx-background-color: #0D1117; -fx-border-color: transparent;">
            <!-- scheduleContent is populated dynamically in the controller (one table per day) -->
            <VBox fx:id="scheduleContent" spacing="20"
                  style="-fx-padding: 10; -fx-background-color: #0D1117;"/>
        </ScrollPane>
    </center>

    <!-- Back button at the bottom -->
    <bottom>
        <Button text="← Back to Dashboard"
                fx:id="btnBack"
                style="-fx-font-size: 14px; -fx-padding: 8 16; -fx-background-color: #161B22; -fx-text-fill: #4B9CFF; -fx-border-color: #21262d; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </bottom>

</BorderPane>
