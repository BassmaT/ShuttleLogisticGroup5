<?xml version="1.0" encoding="UTF-8"?>

<!-- Importiert die benötigten JavaFX-Klassen -->
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<!--
    Wartungshistorie.
    Zeigt alle in dieser Sitzung durchgeführten Reparaturen.
    Die Daten werden beim Schließen der App gelöscht (nur im Arbeitsspeicher).
    fx:controller verknüpft die Datei mit HistoryController.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.HistoryController"
            style="-fx-background-color: #0D1117; -fx-padding: 20;">

    <!-- Seitenüberschrift -->
    <top>
        <Label text="Mission History"
               style="-fx-font-size: 28px; -fx-text-fill: #4B9CFF; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Hauptbereich mit der Histori-Tabelle -->
    <center>
        <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
            <!-- historyTable wird im Controller mit den Reparatur-Tickets befüllt -->
            <TableView fx:id="historyTable"
                       style="-fx-background: #0D1117; -fx-background-color: #161B22;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <!-- Datum und Uhrzeit der Reparatur -->
                    <TableColumn fx:id="colDate"       text="Date"       prefWidth="100"/>
                    <!-- Betroffenes Shuttle-Teil -->
                    <TableColumn fx:id="colPart"       text="Part"       prefWidth="120"/>
                    <!-- Sensor, der die Reparatur ausgelöst hat -->
                    <TableColumn fx:id="colSensor"     text="Sensor"     prefWidth="150"/>
                    <!-- Fehlerstatus vor der Reparatur (farbig dargestellt) -->
                    <TableColumn fx:id="colOldStatus"  text="Status"     prefWidth="90"/>
                    <!-- Durchgeführte Maßnahme inkl. verwendetem Bauteil -->
                    <TableColumn fx:id="colAction"     text="Action"     prefWidth="200"/>
                    <!-- Name des Technikers -->
                    <TableColumn fx:id="colTechnician" text="Technician" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Zurück-Button unten -->
    <bottom>
        <Button text="← Back to Dashboard"
                fx:id="btnBack"
                style="-fx-font-size: 14px; -fx-padding: 8 16; -fx-background-color: #161B22; -fx-text-fill: #4B9CFF; -fx-border-color: #21262d; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
    </bottom>

</BorderPane>
