<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Circle?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group5.shuttle.controller.MainController"
            styleClass="app-root">

    <stylesheets>
        <URL value="@../styles/dashboard.css" />
    </stylesheets>

    <top>
        <HBox spacing="20" styleClass="header-bar" alignment="CENTER_LEFT">
            <Label text="MISSION CONTROL" style="-fx-text-fill: #4B9CFF; -fx-font-weight: bold; -fx-font-size: 20px; -fx-letter-spacing: 2px;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblCurrentUser" text=""
                   style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <Button text="⇄" onAction="#switchUser"
                    style="-fx-background-color: #21262d; -fx-text-fill: #8b949e; -fx-cursor: hand;
                           -fx-padding: 4 8; -fx-border-color: #30363d; -fx-border-radius: 4;"/>
            <Button onAction="#toggleAiChat" text="🤖 AI Chat"
                    style="-fx-background-color: #21262d; -fx-text-fill: #8957e5; -fx-border-color: #8957e5; -fx-border-radius: 5; -fx-cursor: hand;"/>
            <HBox spacing="10" alignment="CENTER" style="-fx-background-color: rgba(75, 156, 255, 0.1); -fx-padding: 8 15; -fx-background-radius: 20;">
                <Circle radius="4" fill="#2EA043" />
                <Label fx:id="lblStatus" text="SYSTEMS NOMINAL" style="-fx-text-fill: #2EA043; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox spacing="10" styleClass="sidebar">
            <Button text="Dashboard" styleClass="sidebar-btn-active"/>
            <Button fx:id="btnMission" text="Mission Control" styleClass="sidebar-btn"/>
            <Button fx:id="btnTechnician" text="Sensor Data" styleClass="sidebar-btn"/>
            <Button fx:id="btnInventory" text="Inventory" styleClass="sidebar-btn"/>
            <Button fx:id="btnHistory" text="History" styleClass="sidebar-btn"/>
            <Button fx:id="btnStaff" text="Staff" styleClass="sidebar-btn"/>
            <Button fx:id="btnLogistics" text="Logistics" styleClass="sidebar-btn"/>
            <Button fx:id="btnSchedule" text="Schedule" styleClass="sidebar-btn"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 25;">

                <VBox fx:id="landingBanner" spacing="15" styleClass="card-lg">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="SHUTTLE APPROACH" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblLandingCountdown" text="T-Minus: --:--" style="-fx-text-fill: #58a6ff; -fx-font-family: 'Monospaced'; -fx-font-size: 16px;"/>
                    </HBox>
                    <ProgressBar fx:id="progressLanding" prefWidth="Infinity" progress="0.0" style="-fx-accent: #58a6ff;"/>
                    <Label fx:id="lblLandingStatus" text="Awaiting data..." style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="10" styleClass="card-lg">
                    <Label text="TAKEOVER PROGRESS" styleClass="card-header"/>
                    <ProgressBar fx:id="progressTakeover" prefWidth="Infinity" progress="0.0" style="-fx-accent: #66ff66;"/>
                    <Label fx:id="lblScheduleStatus" text="Schedule: –" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
                    <Label fx:id="lblApprovalStatus" text="Checking components..." style="-fx-text-fill: white;"/>
                    <Label fx:id="lblWarning" text="Scanning for anomalies..." style="-fx-text-fill: #ffcc00;"/>
                    <Button fx:id="btnFinish" text="Complete Takeover" visible="false" style="-fx-background-color: #66ff66; -fx-text-fill: #0D1117; -fx-font-weight: bold;"/>
                </VBox>

                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" spacing="10" styleClass="card">
                        <Label text="SENSOR MATRIX" styleClass="card-header"/>
                        <VBox fx:id="sensorContainer" spacing="8" />
                    </VBox>

                    <VBox GridPane.columnIndex="1" spacing="10" styleClass="card">
                        <Label text="ACTIVE TASKS" styleClass="card-header"/>
                        <VBox fx:id="activeWorkContainer" spacing="8" />
                        <Label text="Last Activity:" style="-fx-text-fill: #8b949e; -fx-font-size: 11px; -fx-padding: 10 0 0 0;"/>
                        <Label fx:id="lblLastActivity" text="None" style="-fx-text-fill: #58a6ff; -fx-font-size: 11px;"/>
                    </VBox>
                </GridPane>

                <HBox spacing="20">
                    <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="card">
                        <Label text="3-DAY SCHEDULE" styleClass="card-header"/>
                        <VBox fx:id="scheduleContainer" spacing="5" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="card-ai">
                        <Label text="PREDICTIVE AI TRENDS" style="-fx-text-fill: #8957e5; -fx-font-weight: bold;"/>
                        <VBox fx:id="predictiveContainer" spacing="5" />
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <right>
        <StackPane fx:id="aiDrawer" prefWidth="320" styleClass="ai-drawer">
            <VBox spacing="0">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 15;">
                    <Label text="AI ADVISOR" style="-fx-text-fill: #8957e5; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="→" onAction="#toggleAiChat" style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-cursor: hand;"/>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="chatHistory" spacing="10" style="-fx-padding: 15;" />
                </ScrollPane>

                <HBox style="-fx-padding: 15; -fx-background-color: #161B22;">
                    <TextField fx:id="txtChatInput" onAction="#handleChatInput" promptText="Ask AI about costs..." HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #0D1117; -fx-text-fill: white; -fx-border-color: #30363d;"/>
                </HBox>
            </VBox>
        </StackPane>
    </right>

</BorderPane>
